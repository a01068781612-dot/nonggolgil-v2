# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# Environment variables & secrets
.env
.env.*
!.env.example

# External reference archives / portable bundles (1.75 GB)
external/

# Large binary caches & intermediate experiment dumps
*.pkl
*.npz
**/cache/
experiment/*_worktree/
experiment/baseline_mode_b_interim/
