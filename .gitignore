# Reproducible 50MB+ standalone inline bundles (generated by src/build_standalone_web.py)
web/data/inline_bundle.js
web/index_standalone.html
step1_standalone.html

# Large reference PDFs
data/answer/*.pdf

# OS / Office / IDE temporary files
.DS_Store
Thumbs.db
*.tmp
*.bak
*.log
~$*
.vscode/
.idea/
node_modules/
submit_copy/
.wrangler/
